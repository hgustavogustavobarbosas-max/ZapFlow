# =====================================================================
# EDGE FUNCTIONS (SECRETS) — nunca versionar o arquivo real.
# Em produção: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já são injetadas pelo Supabase.
# =====================================================================

# URL pública do frontend (CORS e URLs de retorno do checkout). Ex.: https://app.seudominio.com
APP_URL=http://localhost:8080

# --- Evolution API (v2) ---
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_API_KEY=

# --- IA: openai | gemini ---
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- AbacatePay (API v2) ---
ABACATEPAY_API_KEY=
# ID do produto de assinatura (ciclo MONTHLY) criado no dashboard da AbacatePay
ABACATEPAY_PRODUCT_ID=
ABACATEPAY_PLAN_NAME=ZapFlow Pro
# Secret definido ao cadastrar o webhook (vai na URL como ?webhookSecret=)
ABACATEPAY_WEBHOOK_SECRET=
# Chave pública HMAC da AbacatePay (documentada em "Webhooks > Segurança") para validar X-Webhook-Signature
ABACATEPAY_PUBLIC_KEY=

# Bloqueia o envio de mensagens para contas sem assinatura ativa (true | false)
# Use false em desenvolvimento para testar sem assinar.
REQUIRE_ACTIVE_SUBSCRIPTION=true
